{
    "name":  "erc-awar",
    "version":  "1.0.0-alpha.1",
    "private":  true,
    "packageManager":  "pnpm@11.7.0",
    "description":  "Reference implementation and adapters for Agent Memory State ExperienceDelta v1.",
    "license":  "Apache-2.0",
    "workspaces":  [
                       "packages/*",
                       "implementations/*"
                   ],
    "scripts":  {
                    "clean":  "node scripts/clean.mjs",
                    "build":  "pnpm --filter @erc-awar/core build \u0026\u0026 pnpm --filter @erc-awar/reference-engine build \u0026\u0026 pnpm --filter @erc-awar/awareness-adapter build \u0026\u0026 pnpm --filter @erc-awar/minimal-independent build \u0026\u0026 pnpm --filter @erc-awar/examples build",
                    "typecheck":  "pnpm build \u0026\u0026 pnpm -r --if-present typecheck",
                    "test:ts":  "pnpm build \u0026\u0026 pnpm -r --if-present test",
                    "test:contracts":  "cd contracts \u0026\u0026 forge test",
                    "test:golden:core":  "pnpm --filter @erc-awar/core test:golden",
                    "test:golden:minimal":  "pnpm --filter @erc-awar/minimal-independent test:golden",
                    "test:golden:solidity":  "cd contracts \u0026\u0026 forge test --match-path test/unit/GoldenVector.t.sol -vv",
                    "format:check":  "cd contracts \u0026\u0026 forge fmt --check",
                    "check:erc-assets":  "node scripts/check-erc-assets.mjs",
                    "check:vectors":  "node scripts/check-vectors.mjs",
                    "build:vectors":  "node scripts/build-test-vectors-v2.mjs",
                    "check:reproducible":  "node scripts/build-test-vectors-v2.mjs --check \u0026\u0026 node scripts/fixture/build-fixture-witness.mjs --check",
                    "check:private-witness":  "node scripts/private-witness-demo.mjs",
                    "demo:private-witness":  "pnpm --filter @erc-awar/core build \u0026\u0026 pnpm --filter @erc-awar/reference-engine build \u0026\u0026 pnpm check:private-witness \u0026\u0026 cd contracts \u0026\u0026 forge test --match-path test/integration/PrivateWitnessEvidence.t.sol -vv",
                    "evidence:validate":  "node scripts/external-reproduction-gate.mjs --validate-only",
                    "evidence:test":  "node --test scripts/external-reproduction-gate.test.mjs",
                    "evidence:external":  "node scripts/external-reproduction-gate.mjs",
                    "security:handoff":  "node scripts/security-audit-handoff.mjs",
                    "security:scope":  "node scripts/security-rc-gate.mjs --scope-only \u0026\u0026 pnpm security:handoff",
                    "security:test":  "node --test scripts/security-rc-gate.test.mjs scripts/security-audit-handoff.test.mjs",
                    "security:rc":  "pnpm security:handoff \u0026\u0026 node scripts/security-rc-gate.mjs",
                    "release:metadata":  "node scripts/release-metadata-gate.mjs",
                    "release:test":  "node --test scripts/release-metadata-gate.test.mjs",
                    "test":  "pnpm test:ts \u0026\u0026 pnpm check:vectors \u0026\u0026 pnpm check:reproducible \u0026\u0026 pnpm test:contracts",
                    "check":  "pnpm clean \u0026\u0026 pnpm build \u0026\u0026 pnpm -r --if-present typecheck \u0026\u0026 pnpm -r --if-present test \u0026\u0026 pnpm check:erc-assets \u0026\u0026 pnpm check:vectors \u0026\u0026 pnpm check:reproducible \u0026\u0026 pnpm check:private-witness \u0026\u0026 pnpm evidence:validate \u0026\u0026 pnpm evidence:test \u0026\u0026 pnpm security:scope \u0026\u0026 pnpm security:test \u0026\u0026 pnpm release:test \u0026\u0026 pnpm format:check \u0026\u0026 pnpm test:contracts",
                    "conformance:gate":  "node scripts/conformance-gate.mjs",
                    "conformance:clean":  "node scripts/clean-checkout-conformance.mjs",
                    "audit":  "pnpm audit --audit-level=moderate",
                    "release:check":  "pnpm release:metadata \u0026\u0026 pnpm release:test \u0026\u0026 pnpm conformance:gate \u0026\u0026 pnpm security:rc \u0026\u0026 pnpm audit --audit-level=moderate"
                },
    "devDependencies":  {
                            "@noble/curves":  "^2.2.0",
                            "@noble/hashes":  "^1.8.0",
                            "vite":  "8.1.4"
                        }
}
