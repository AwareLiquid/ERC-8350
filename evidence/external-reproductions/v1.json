      "assertions": [
        {
          "id": "non-empty-chain",
          "pattern": "^TransitionCommitted [1-9][0-9]* logs across [1-9][0-9]* Memory Spaces$"
        },
        {
          "id": "second-rpc-agrees",
          "pattern": "^cross-check\\s+.+ agrees$"
        },
        {
          "id": "all-spaces-verified",
          "pattern": "^RESULT: ALL SPACES VERIFIED-GOOD$"
        }
      ],
      "scope": [
        "Recomputes every emitted transitionId from the ERC-8350 type string",
        "Recomputes every nextStateRoot and checks gapless sequence/root linkage",
        "Walks account and storage proofs to compare the materialized head",
        "Rebuilds the observation block header and cross-checks a second RPC"
      ],
      "nonClaims": [
        "Does not prove that one RPC did not omit an entire Memory Space",
        "Assumes the published reference contract storage layout",
        "Is not a Solidity security audit or a full independent ERC-8350 client"
      ]
    },
